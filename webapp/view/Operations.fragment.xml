<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<TableSelectDialog
		id="selectOperation"
		noDataText="No Operations Found"
		title="Select Operation"
		search=".handleSearch"
		confirm=".handleConfirm"
		cancel=".handleClose"
		items="{
			path : 'workOrderModel>/Operations'
		}">
		<ColumnListItem vAlign="Middle">
			<cells>
				<Text text="{workOrderModel>OrderID}" />
                <Text text="{workOrderModel>OperationNo}" />
                <Text text="{workOrderModel>OperationText}" />
			</cells>
		</ColumnListItem>
		<columns>
			<Column width="12em">
				<header>
					<Text text="{i18n>OrderID}" />
				</header>
			</Column>
            			<Column width="12em">
				<header>
					<Text text="{i18n>OperationNo}" />
				</header>
			</Column>
            			<Column width="12em">
				<header>
					<Text text="{i18n>OperationText}" />
				</header>
			</Column>
		</columns>
	</TableSelectDialog>
</core:FragmentDefinition>